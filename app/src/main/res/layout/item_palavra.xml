<?xml version="1.0" encoding="utf-8"?>
<!-- layout de cada item do RecyclerView: palavra em cima e categoria embaixo -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="4dp"
    android:background="@drawable/bg_painel"
    android:orientation="vertical"
    android:padding="@dimen/espaco_medio">

    <TextView
        android:id="@+id/textPalavra"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/texto"
        android:textSize="@dimen/texto_normal"
        android:textStyle="bold"
        tools:text="Matrix" />

    <TextView
        android:id="@+id/textCategoria"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/laranja"
        android:textSize="@dimen/texto_pequeno"
        tools:text="Filmes" />
</LinearLayout>
