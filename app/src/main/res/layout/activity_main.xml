<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageLogo"
        android:layout_width="@dimen/tamanho_logo"
        android:layout_height="@dimen/tamanho_logo"
        android:layout_marginTop="@dimen/espaco_grande"
        android:contentDescription="@string/desc_logo"
        android:src="@drawable/ic_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/textTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/roxo"
        android:textSize="@dimen/texto_titulo"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/imageLogo" />

    <TextView
        android:id="@+id/textSubtitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitulo_app"
        android:textColor="@color/texto_suave"
        android:textSize="@dimen/texto_pequeno"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textTitulo" />

    <TextView
        android:id="@+id/textNome"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/margem_tela"
        android:layout_marginTop="@dimen/espaco_grande"
        android:layout_marginEnd="@dimen/margem_tela"
        android:text="@string/aluno_nome"
        android:textColor="@color/texto"
        android:textSize="@dimen/texto_subtitulo"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/textSubtitulo" />

    <TextView
        android:id="@+id/textMatricula"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/aluno_matricula"
        android:textColor="@color/texto"
        android:textSize="@dimen/texto_normal"
        app:layout_constraintEnd_toEndOf="@id/textNome"
        app:layout_constraintStart_toStartOf="@id/textNome"
        app:layout_constraintTop_toBottomOf="@id/textNome" />

    <TextView
        android:id="@+id/textCurso"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/aluno_curso"
        android:textColor="@color/texto"
        android:textSize="@dimen/texto_normal"
        app:layout_constraintEnd_toEndOf="@id/textNome"
        app:layout_constraintStart_toStartOf="@id/textNome"
        app:layout_constraintTop_toBottomOf="@id/textMatricula" />

    <View
        android:id="@+id/divisor"
        android:layout_width="0dp"
        android:layout_height="2dp"
        android:layout_marginTop="@dimen/margem_tela"
        android:background="@color/roxo"
        app:layout_constraintEnd_toEndOf="@id/textNome"
        app:layout_constraintStart_toStartOf="@id/textNome"
        app:layout_constraintTop_toBottomOf="@id/textCurso" />

    <TextView
        android:id="@+id/labelApelido"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margem_tela"
        android:labelFor="@id/editApelido"
        android:text="@string/label_apelido"
        android:textColor="@color/texto"
        android:textSize="@dimen/texto_pequeno"
        app:layout_constraintEnd_toEndOf="@id/textNome"
        app:layout_constraintStart_toStartOf="@id/textNome"
        app:layout_constraintTop_toBottomOf="@id/divisor" />

    <EditText
        android:id="@+id/editApelido"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:autofillHints="username"
        android:hint="@string/hint_apelido"
        android:inputType="textPersonName"
        android:maxLength="20"
        android:minHeight="48dp"
        app:layout_constraintEnd_toEndOf="@id/textNome"
        app:layout_constraintStart_toStartOf="@id/textNome"
        app:layout_constraintTop_toBottomOf="@id/labelApelido" />

    <Button
        android:id="@+id/botaoEntrar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:backgroundTint="@color/laranja"
        android:text="@string/botao_entrar"
        app:layout_constraintEnd_toEndOf="@id/textNome"
        app:layout_constraintStart_toStartOf="@id/textNome"
        app:layout_constraintTop_toBottomOf="@id/editApelido" />

    <TextView
        android:id="@+id/textUltimoModulo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/espaco_medio"
        android:textColor="@color/roxo"
        android:textSize="@dimen/texto_pequeno"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@id/textNome"
        app:layout_constraintStart_toStartOf="@id/textNome"
        app:layout_constraintTop_toBottomOf="@id/botaoEntrar" />

    <TextView
        android:id="@+id/textAviso"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/margem_tela"
        android:text="@string/aviso_individual"
        android:textColor="@color/texto_suave"
        android:textSize="@dimen/texto_pequeno"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
