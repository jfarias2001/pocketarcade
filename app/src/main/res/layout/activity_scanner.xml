<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ScannerActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/scanner_titulo"
            android:textColor="@color/roxo"
            android:textSize="@dimen/texto_titulo"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textJogador"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texto_suave"
            tools:text="Jogador: Fulano" />


        <EditText
            android:id="@+id/editMensagem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_medio"
            android:hint="@string/hint_mensagem"
            android:importantForAutofill="no"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLength="200"
            android:minHeight="48dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botaoAnalisar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/botao_analisar" />

            <Button
                android:id="@+id/botaoLimpar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/botao_limpar" />
        </LinearLayout>

        <!-- painel de resultado: fica escondido ate a primeira analise -->
        <TableLayout
            android:id="@+id/painelResultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_tela"
            android:background="@drawable/bg_resultado"
            android:padding="@dimen/espaco_medio"
            android:stretchColumns="1"
            android:visibility="gone"
            tools:visibility="visible">

            <TableRow>

                <TextView
                    android:layout_width="@dimen/largura_coluna_medida"
                    android:text="@string/coluna_medida"
                    android:textColor="@color/texto"
                    android:textStyle="bold" />

                <TextView
                    android:text="@string/coluna_resultado"
                    android:textColor="@color/texto"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_marginTop="@dimen/espaco_pequeno">

                <TextView
                    android:text="@string/medida_caracteres"
                    android:textColor="@color/texto" />

                <TextView
                    android:id="@+id/textCaracteres"
                    android:textColor="@color/texto" />
            </TableRow>

            <TableRow android:layout_marginTop="@dimen/espaco_pequeno">

                <TextView
                    android:text="@string/medida_palavras"
                    android:textColor="@color/texto" />

                <TextView
                    android:id="@+id/textPalavras"
                    android:textColor="@color/texto" />
            </TableRow>

            <TableRow android:layout_marginTop="@dimen/espaco_pequeno">

                <TextView
                    android:text="@string/medida_vogais"
                    android:textColor="@color/texto" />

                <TextView
                    android:id="@+id/textVogais"
                    android:textColor="@color/texto" />
            </TableRow>

            <TableRow android:layout_marginTop="@dimen/espaco_pequeno">

                <TextView
                    android:text="@string/medida_invertido"
                    android:textColor="@color/texto" />

                <TextView
                    android:id="@+id/textInvertido"
                    android:textColor="@color/texto" />
            </TableRow>

            <TableRow android:layout_marginTop="@dimen/espaco_pequeno">

                <TextView
                    android:text="@string/medida_palindromo"
                    android:textColor="@color/texto" />

                <TextView
                    android:id="@+id/textPalindromo"
                    android:textColor="@color/texto"
                    android:textStyle="bold" />
            </TableRow>
        </TableLayout>

        <!-- ocupa o espaco que sobrar e empurra os botoes para baixo -->
        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_grande"
            android:orientation="horizontal">

            <Button
                android:id="@+id/botaoVoltar"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/botao_voltar" />

            <Button
                android:id="@+id/botaoEncerrar"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/botao_encerrar" />
        </LinearLayout>
    </LinearLayout>

</androidx.core.widget.NestedScrollView>
